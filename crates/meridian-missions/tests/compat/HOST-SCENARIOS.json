[
  {
    "id": "allocator-freed-heap-does-not-refund-cumulative",
    "operation": "allocator_accounting_contract",
    "input": {
      "heapLimit": 65536,
      "allocationLimit": 65536,
      "initialHeap": 0,
      "initialAllocated": 0,
      "requests": [
        {
          "newPointer": true,
          "newSize": 32768
        },
        {
          "oldSize": 32768,
          "newSize": 16384
        },
        {
          "oldSize": 16384,
          "newSize": 0
        },
        {
          "newPointer": true,
          "newSize": 20000
        }
      ]
    },
    "expected": {
      "trace": [
        {
          "success": true,
          "heap": 32768,
          "allocated": 32768
        },
        {
          "success": true,
          "heap": 16384,
          "allocated": 49152
        },
        {
          "success": true,
          "heap": 0,
          "allocated": 49152
        },
        {
          "success": false,
          "heap": 0,
          "allocated": 49152
        }
      ],
      "policy": "Charge whole new_size on every successful allocation/reallocation, even shrink; free only reduces live heap. Rejected allocation changes neither counter."
    },
    "refs": [
      "Sources/MissionScript/MissionScript.c"
    ]
  },
  {
    "id": "allocator-new-pointer-type-tag-is-not-old-size",
    "operation": "allocator_accounting_contract",
    "input": {
      "heapLimit": 65536,
      "allocationLimit": 65536,
      "initialHeap": 0,
      "initialAllocated": 0,
      "requests": [
        {
          "newPointer": true,
          "oldSizeTypeTag": 5,
          "newSize": 128
        }
      ]
    },
    "expected": {
      "trace": [
        {
          "success": true,
          "heap": 128,
          "allocated": 128
        }
      ],
      "policy": "Lua old_size is a type tag for a new pointer; replace it with zero."
    },
    "refs": [
      "Sources/MissionScript/MissionScript.c"
    ]
  },
  {
    "id": "allocator-system-realloc-failure-keeps-counters",
    "operation": "allocator_accounting_contract",
    "input": {
      "heapLimit": 65536,
      "allocationLimit": 65536,
      "initialHeap": 1024,
      "initialAllocated": 1024,
      "requests": [
        {
          "oldSize": 1024,
          "newSize": 2048,
          "systemReallocFails": true
        }
      ]
    },
    "expected": {
      "trace": [
        {
          "success": false,
          "heap": 1024,
          "allocated": 1024
        }
      ],
      "policy": "System allocation failure charges nothing and retains the previous allocation."
    },
    "refs": [
      "Sources/MissionScript/MissionScript.c"
    ]
  },
