+/// Meridian's cumulative allocator budget; no VM handles or native pointers escape.
+#[derive(Debug)]
+pub struct AllocationBudget {
+    limit: usize,
+    allocated: std::sync::atomic::AtomicUsize,
+    peak: std::sync::atomic::AtomicUsize,
+}
+
+impl AllocationBudget {
+    /// Start a separate observer for one fresh VM.
+    pub fn new(limit: usize) -> Self {
+        Self {
+            limit,
+            allocated: std::sync::atomic::AtomicUsize::new(0),
+            peak: std::sync::atomic::AtomicUsize::new(0),
+        }
+    }
+
+    /// Sum of new sizes for successful nonzero allocation/reallocation requests.
+    pub fn allocated_bytes(&self) -> usize {
+        self.allocated.load(std::sync::atomic::Ordering::Relaxed)
+    }
+
+    /// Maximum live VM allocation size observed, including trusted initialization.
+    pub fn peak_heap_bytes(&self) -> usize {
+        self.peak.load(std::sync::atomic::Ordering::Relaxed)
+    }
+
+    pub(crate) fn permits(&self, requested: usize) -> bool {
+        requested <= self.limit.saturating_sub(self.allocated_bytes())
+    }
+
+    pub(crate) fn record(&self, requested: usize, live: usize) {
+        self.allocated.fetch_add(requested, std::sync::atomic::Ordering::Relaxed);
+        self.peak.fetch_max(live, std::sync::atomic::Ordering::Relaxed);
